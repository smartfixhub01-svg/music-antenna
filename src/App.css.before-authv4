.auth-tab-bar {
  display: flex;
  gap: 6px;
  padding: 4px;
  border-radius: 22px;
  background: #0f0f0f;
  border: 1px solid #212121;
  margin-bottom: 14px;
}
.auth-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 10px 12px;
  border: 0;
  border-radius: 18px;
  background: transparent;
  color: #aaaaaa;
  font-family: inherit;
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  transition: background .15s, color .15s;
}
.auth-tab:hover { color: #f1f1f1; }
.auth-tab .material-symbols-outlined { font-size: 18px; }
.auth-tab-active {
  background: #272727;
  color: #f1f1f1;
}
.auth-tab-active .material-symbols-outlined { color: #3ea6ff; }

.auth-tab-sub {
  margin: 0 0 18px;
  padding: 0 4px;
  color: #aaaaaa;
  font-size: 12px;
  line-height: 1.45;
}

.auth-tab-form {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.auth-tab-form label {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.auth-tab-form label span {
  font-size: 12px;
  color: #aaaaaa;
  font-weight: 500;
}
.auth-tab-form input {
  width: 100%;
  padding: 12px 14px;
  border: 1px solid #303030;
  border-radius: 8px;
  background: #0f0f0f;
  color: #f1f1f1;
  font-family: inherit;
  font-size: 14px;
  outline: none;
}
.auth-tab-form input:focus { border-color: #3ea6ff; }

.auth-tab-submit {
  margin-top: 6px;
  padding: 12px 20px;
  border: 0;
  border-radius: 22px;
  background: #3ea6ff;
  color: #0f0f0f;
  font-family: inherit;
  font-size: 14px;
  font-weight: 700;
  cursor: pointer;
}
.auth-tab-submit:hover { background: #1c8be0; }
.auth-tab-submit:disabled { opacity: .6; cursor: not-allowed; }

.auth-tab-links {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
  margin-top: 14px;
}
.auth-tab-links button,
.auth-tab-back {
  padding: 0;
  border: 0;
  background: transparent;
  color: #3ea6ff;
  font-family: inherit;
  font-size: 12px;
  font-weight: 500;
  text-align: left;
  cursor: pointer;
}
.auth-tab-links button:hover { text-decoration: underline; }

.auth-tab-back {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  margin-bottom: 12px;
  font-size: 13px;
}
.auth-tab-back .material-symbols-outlined { font-size: 18px; }

.auth-tab-section {
  display: flex;
  flex-direction: column;
  gap: 14px;
}
.auth-tab-head {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 4px 0;
}
.auth-tab-head .material-symbols-outlined {
  font-size: 28px;
  color: #3ea6ff;
}
.auth-tab-head h2 {
  margin: 0;
  font-size: 17px;
  font-weight: 600;
}
.auth-tab-head p {
  margin: 2px 0 0;
  color: #aaaaaa;
  font-size: 12px;
}

.auth-tab-message {
  margin: 18px 0 0;
  padding: 10px 12px;
  border-radius: 8px;
  background: #1c2130;
  color: #c9d1e1;
  font-size: 12px;
  line-height: 1.45;
}

.auth-tab-footnote {
  margin: 20px 0 0;
  color: #6b7280;
  font-size: 11px;
  text-align: center;
}

/* password visibility toggle */
.auth-pw-wrap {
  position: relative;
  display: flex;
  align-items: center;
}
.auth-pw-wrap input {
  padding-right: 46px !important;
}
.auth-pw-toggle {
  position: absolute;
  right: 4px;
  top: 50%;
  transform: translateY(-50%);
  display: grid;
  place-items: center;
  width: 38px;
  height: 38px;
  border: 0;
  border-radius: 50%;
  background: transparent;
  color: #aaaaaa;
  cursor: pointer;
}
.auth-pw-toggle:hover {
  color: #f1f1f1;
  background: #1c1c1c;
}
.auth-pw-toggle .material-symbols-outlined {
  font-size: 20px;
}
