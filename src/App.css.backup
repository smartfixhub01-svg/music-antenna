@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

:root {
  font-family: 'Inter', sans-serif;
  color: #f8fafc;
  background: #090b10;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  font-optical-sizing: auto;
  font-weight: 400;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
  background: #090b10;
}

button,
input {
  font: inherit;
}

button {
  cursor: pointer;
}

#root {
  min-height: 100vh;
}

.app {
  min-height: 100vh;
  display: flex;
  background: #090b10;
}

.sidebar {
  width: 245px;
  flex-shrink: 0;
  padding: 30px 20px;
  background: #0e1119;
  border-right: 1px solid #202430;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 42px;
}

.brand-icon {
  width: 43px;
  height: 43px;
  display: grid;
  place-items: center;
  border-radius: 14px;
  background: linear-gradient(135deg, #a855f7, #ec4899);
  font-size: 25px;
}

.brand h1 {
  margin: 0;
  font-size: 19px;
  font-weight: 800;
  letter-spacing: -0.7px;
}

.brand p {
  margin: 4px 0 0;
  color: #9299aa;
  font-size: 11px;
}

.nav-label {
  margin: 28px 10px 12px;
  color: #777f92;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.6px;
  text-transform: uppercase;
}

.nav-button {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 13px 14px;
  margin: 5px 0;
  border: 0;
  border-radius: 12px;
  background: transparent;
  color: #9ca3b4;
  text-align: left;
  transition: 0.2s;
}

.nav-button:hover {
  background: #1a1e2a;
  color: #fff;
}

.nav-button.active {
  background: linear-gradient(90deg, #8b5cf6, #6d43d8);
  color: #fff;
  box-shadow: 0 8px 25px #7c3aed30;
}

.nav-icon {
  font-size: 19px;
}

.main {
  flex: 1;
  min-width: 0;
  padding: 30px 35px 110px;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 35px;
}

.search-box {
  width: min(440px, 100%);
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 13px 16px;
  border: 1px solid #272c3a;
  border-radius: 14px;
  background: #121620;
}

.search-box span {
  color: #939bad;
  font-size: 19px;
}

.search-box input {
  width: 100%;
  min-width: 0;
  outline: none;
  border: 0;
  background: transparent;
  color: #fff;
  font-size: 13px;
}

.search-box input::placeholder {
  color: #747c90;
}

.profile {
  display: flex;
  align-items: center;
  gap: 10px;
  color: #cbd0dc;
  font-size: 12px;
}

.avatar {
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: linear-gradient(135deg, #06b6d4, #8b5cf6);
  font-weight: 800;
}

.hero {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  min-height: 290px;
  padding: 40px;
  margin-bottom: 38px;
  border: 1px solid #6c46bb55;
  border-radius: 25px;
  background:
    radial-gradient(ellipse at 85% 15%, #c026d355, transparent 40%),
    radial-gradient(ellipse at 65% 100%, #6d28d955, transparent 45%),
    linear-gradient(115deg, #20133d, #171126 65%, #26133c);
}

.hero-content {
  position: relative;
  z-index: 1;
  max-width: 480px;
}

.eyebrow {
  color: #c4a5fd;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 2px;
  text-transform: uppercase;
}

.hero h2 {
  margin: 17px 0 12px;
  font-size: clamp(30px, 4vw, 47px);
  line-height: 1.12;
  letter-spacing: -2px;
}

.hero p {
  max-width: 390px;
  color: #c4bfd3;
  font-size: 13px;
  line-height: 1.8;
}

.primary-button {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 13px 21px;
  margin-top: 13px;
  border: 0;
  border-radius: 12px;
  background: #a78bfa;
  color: #180c2b;
  font-size: 12px;
  font-weight: 800;
  transition: 0.2s;
}

.primary-button:hover {
  background: #c4b5fd;
  transform: translateY(-2px);
}

.hero-art {
  width: 185px;
  height: 185px;
  flex-shrink: 0;
  display: grid;
  place-items: center;
  border: 1px solid #ffffff25;
  border-radius: 35px;
  background: linear-gradient(135deg, #ec4899, #8b5cf6 55%, #312e81);
  box-shadow: 0 20px 65px #0005;
  font-size: 80px;
  transform: rotate(7deg);
}

.content {
  margin-top: 35px;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  margin-bottom: 22px;
}

.section-heading h2 {
  margin: 7px 0 0;
  font-size: 23px;
  letter-spacing: -0.8px;
}

.count {
  color: #8d95a7;
  font-size: 12px;
}

.music-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 20px;
}

.music-card {
  min-width: 0;
  padding: 12px;
  border: 1px solid transparent;
  border-radius: 18px;
  background: #11151f;
  transition: 0.2s;
}

.music-card:hover {
  border-color: #39314f;
  background: #171b28;
  transform: translateY(-4px);
}

.cover {
  position: relative;
  overflow: hidden;
  display: grid;
  place-items: center;
  aspect-ratio: 1;
  border-radius: 13px;
  font-size: 48px;
}

.cover::after {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, transparent 50%, #0004);
  content: "";
  pointer-events: none;
}

.cover-purple {
  background: linear-gradient(135deg, #7c3aed, #ec4899);
}

.cover-blue {
  background: linear-gradient(135deg, #0284c7, #312e81);
}

.cover-orange {
  background: linear-gradient(135deg, #f97316, #be123c);
}

.cover-green {
  background: linear-gradient(135deg, #059669, #164e63);
}

.cover-pink {
  background: linear-gradient(135deg, #db2777, #7c3aed);
}

.cover-gold {
  background: linear-gradient(135deg, #ca8a04, #ea580c);
}

.cover-cyan {
  background: linear-gradient(135deg, #0891b2, #4f46e5);
}

.cover-red {
  background: linear-gradient(135deg, #dc2626, #7f1d1d);
}

.play-overlay {
  position: absolute;
  z-index: 1;
  right: 10px;
  bottom: 10px;
  width: 39px;
  height: 39px;
  border: 0;
  border-radius: 50%;
  background: #fff;
  color: #111;
  font-size: 16px;
  box-shadow: 0 5px 20px #0003;
  opacity: 0;
  transform: translateY(5px);
  transition: 0.2s;
}

.music-card:hover .play-overlay {
  opacity: 1;
  transform: translateY(0);
}

.track-title {
  overflow: hidden;
  margin: 14px 0 6px;
  color: #f4f5fa;
  font-size: 13px;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.track-artist {
  overflow: hidden;
  margin: 0;
  color: #8d95a7;
  font-size: 11px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.empty-state {
  padding: 55px 20px;
  border: 1px dashed #303647;
  border-radius: 18px;
  text-align: center;
}

.empty-state > span {
  color: #a78bfa;
  font-size: 40px;
}

.empty-state h3 {
  margin-bottom: 8px;
}

.empty-state p {
  color: #9299aa;
  font-size: 13px;
}

.player-bar {
  position: fixed;
  z-index: 5;
  right: 0;
  bottom: 0;
  left: 245px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  min-height: 85px;
  padding: 14px 30px;
  border-top: 1px solid #292d3a;
  background: #10131ced;
  backdrop-filter: blur(18px);
}

.now-playing {
  display: flex;
  align-items: center;
  gap: 12px;
  min-width: 0;
}

.mini-cover {
  width: 49px;
  height: 49px;
  display: grid;
  flex-shrink: 0;
  place-items: center;
  border-radius: 10px;
  background: linear-gradient(135deg, #7c3aed, #ec4899);
  font-size: 24px;
}

.now-playing h4 {
  overflow: hidden;
  margin: 0 0 5px;
  font-size: 12px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.now-playing p {
  overflow: hidden;
  margin: 0;
  color: #9299aa;
  font-size: 10px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.player-controls {
  display: flex;
  align-items: center;
  gap: 20px;
}

.player-controls button {
  border: 0;
  background: transparent;
  color: #c6cada;
  font-size: 19px;
}

.player-controls .main-play {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background: #a78bfa;
  color: #171026;
}

.player-message {
  color: #969daf;
  font-size: 11px;
}

@media (max-width: 1100px) {
  .sidebar {
    width: 200px;
    padding: 25px 14px;
  }

  .main {
    padding: 25px 22px 110px;
  }

  .player-bar {
    left: 200px;
    padding: 12px 20px;
  }

  .music-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .hero-art {
    width: 140px;
    height: 140px;
    font-size: 60px;
  }
}

@media (max-width: 700px) {
  .app {
    display: block;
    padding-bottom: 65px;
  }

  .sidebar {
    position: fixed;
    z-index: 10;
    right: 0;
    bottom: 0;
    left: 0;
    display: flex;
    align-items: center;
    justify-content: space-around;
    width: auto;
    height: 65px;
    padding: 6px 5px;
    border-top: 1px solid #292d3a;
    border-right: 0;
    background: #0e1119;
  }

  .brand,
  .nav-label {
    display: none;
  }

  .nav-button {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    min-width: 0;
    max-width: 90px;
    padding: 8px 2px;
    margin: 0 2px;
    border-radius: 10px;
    text-align: center;
    font-size: 9px;
  }

  .nav-icon {
    font-size: 20px;
  }

  .main {
    padding: 20px 15px 125px;
  }

  .topbar {
    gap: 12px;
    margin-bottom: 23px;
  }

  .profile > span:last-child {
    display: none;
  }

  .search-box {
    padding: 12px;
  }

  .hero {
    min-height: 235px;
    padding: 25px 20px;
    border-radius: 20px;
  }

  .hero h2 {
    font-size: 30px;
    letter-spacing: -1.2px;
  }

  .hero p {
    font-size: 11px;
  }

  .hero-art {
    width: 80px;
    height: 80px;
    border-radius: 20px;
    font-size: 38px;
  }

  .music-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .music-card {
    padding: 9px;
  }

  .play-overlay {
    width: 34px;
    height: 34px;
    opacity: 1;
    transform: none;
  }

  .section-heading h2 {
    font-size: 20px;
  }

  .player-bar {
    right: 0;
    bottom: 65px;
    left: 0;
    min-height: 70px;
    gap: 8px;
    padding: 10px 13px;
  }

  .mini-cover {
    width: 42px;
    height: 42px;
  }

  .player-controls {
    gap: 12px;
  }

  .player-controls button {
    font-size: 16px;
  }

  .player-controls .main-play {
    width: 37px;
    height: 37px;
  }

  .player-message {
    display: none;
  }
}

@media (max-width: 380px) {
  .hero-art {
    display: none;
  }

  .hero h2 {
    font-size: 28px;
  }

  .player-controls {
    gap: 8px;
  }
}
