import { useEffect, useState } from "react";
import { supabase } from "./lib/supabase";
import "./App.css";

const BUCKET = "music-antenna-media";

export default function App() {
  const [session, setSession] = useState(null);
  const [loading, setLoading] = useState(true);
  const [busy, setBusy] = useState(false);
  const [mode, setMode] = useState("login");
  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");
  const [displayName, setDisplayName] = useState("");
  const [accountType, setAccountType] = useState("listener");
  const [message, setMessage] = useState("");

  const [media, setMedia] = useState([]);
  const [feedLoading, setFeedLoading] = useState(false);
  const [search, setSearch] = useState("");
  const [navVisible, setNavVisible] = useState(true);

  useEffect(() => {
    let lastNavScrollY = window.scrollY;
    let ticking = false;

    const handleNavScroll = () => {
      if (ticking) return;
      ticking = true;

      window.requestAnimationFrame(() => {
        const currentY = window.scrollY;
        if (currentY < 40 || currentY < lastNavScrollY - 5) {
          setNavVisible(true);
        } else if (currentY > lastNavScrollY + 5) {
          setNavVisible(false);
        }
        lastNavScrollY = currentY;
        ticking = false;
      });
    };

    window.addEventListener("scroll", handleNavScroll, { passive: true });
    return () => window.removeEventListener("scroll", handleNavScroll);
  }, []);

  const [category, setCategory] = useState("All");
  const [activeMedia, setActiveMedia] = useState(null);
  const [showUpload, setShowUpload] = useState(false);
  const [uploadTitle, setUploadTitle] = useState("");
  const [uploadDescription, setUploadDescription] = useState("");
  const [uploadFile, setUploadFile] = useState(null);
  const [allowDownload, setAllowDownload] = useState(false);
  const [profile, setProfile] = useState(null);
  const [menuOpen, setMenuOpen] = useState(false);
  const [sidebarCollapsed, setSidebarCollapsed] = useState(false);
  const [showAccountPage, setShowAccountPage] = useState(false);

  const [showChannelPage, setShowChannelPage] = useState(false);
  const [channelProfile, setChannelProfile] = useState(null);
  const [channelMedia, setChannelMedia] = useState([]);
  const [channelLoading, setChannelLoading] = useState(false);
  const [channelTab, setChannelTab] = useState("Videos");

  const [likedIds, setLikedIds] = useState(() => {
    try {
      const raw = localStorage.getItem("ma_likes");
      return raw ? JSON.parse(raw) : [];
    } catch {
      return [];
    }
  });

  function openPlayer(item) {
    if (!item) return;
    setShowAccountPage(false);
    setShowChannelPage(false);
    setActiveMedia(item);
    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  function toggleLike(id) {
    setLikedIds((prev) => {
      const next = prev.includes(id)
        ? prev.filter((x) => x !== id)
        : [...prev, id];
      try {
        localStorage.setItem("ma_likes", JSON.stringify(next));
      } catch {}
      return next;
    });
  }

  const [history, setHistory] = useState(() => {
    try {
      const raw = localStorage.getItem("ma_history");
      return raw ? JSON.parse(raw) : [];
    } catch {
      return [];
    }
  });

  useEffect(() => {
    if (!activeMedia) return;
    const entry = {
      id: activeMedia.id,
      title: activeMedia.title,
      media_type: activeMedia.media_type,
      thumbnailUrl: activeMedia.thumbnailUrl,
      created_at: activeMedia.created_at,
    };
    setHistory((prev) => {
      const filtered = prev.filter((x) => x.id !== entry.id);
      const next = [entry, ...filtered].slice(0, 20);
      try {
        localStorage.setItem("ma_history", JSON.stringify(next));
      } catch {}
      return next;
    });
  }, [activeMedia]);

  const [showProfileEditor, setShowProfileEditor] = useState(false);
  const [profileName, setProfileName] = useState("");
  const [profileBio, setProfileBio] = useState("");
  const [profilePhotoFile, setProfilePhotoFile] = useState(null);
  const [coverPhotoFile, setCoverPhotoFile] = useState(null);
  const [profileSaving, setProfileSaving] = useState(false);

  const [artistLoading, setArtistLoading] = useState(false);
  const [showArtistStudio, setShowArtistStudio] = useState(false);


  useEffect(() => {
    let alive = true;

    supabase.auth.getSession().then(({ data, error }) => {
      if (!alive) return;
      if (error) setMessage(error.message);
      setSession(data?.session ?? null);
      setLoading(false);
    });

    const {
      data: { subscription },
    } = supabase.auth.onAuthStateChange((_event, newSession) => {
      setSession(newSession);
    });

    return () => {
      alive = false;
      subscription.unsubscribe();
    };
  }, []);

  useEffect(() => {
    loadMedia();
  }, []);

  useEffect(() => {
    let alive = true;

    async function fetchProfile() {
      if (!session?.user?.id) {
        setProfile(null);
        return;
      }

      setArtistLoading(true);

      try {
        const user = session.user;
        const name =
          user.user_metadata?.display_name ||
          user.email?.split("@")[0] ||
          "Music Antenna User";

        let { data, error } = await supabase
          .from("profiles")
          .select("id,display_name,role,created_at,username,bio,avatar_url,cover_url,updated_at")
          .eq("id", user.id)
          .maybeSingle();

        if (error) throw error;

        if (!data) {
          const result = await supabase
            .from("profiles")
            .insert({
              id: user.id,
              display_name: name,
              role: ["artist", "listener"].includes(user.user_metadata?.account_type)
                ? user.user_metadata.account_type
                : "listener",
            })
            .select("id,display_name,role,created_at,username,bio,avatar_url,cover_url,updated_at")
            .single();

          if (result.error) throw result.error;
          data = result.data;
        }

        if (alive) setProfile(data);
      } catch (error) {
        if (alive) {
          setMessage(
            "Could not load your profile: " +
              (error.message || "Unknown error")
          );
        }
      } finally {
        if (alive) setArtistLoading(false);
      }
    }

    fetchProfile();

    return () => {
      alive = false;
    };
  }, [session?.user?.id]);

  async function loadMedia() {
    setFeedLoading(true);
    setMessage("");

    try {
      const { data, error } = await supabase
        .from("media")
        .select(
          "id,artist_id,title,description,media_type,storage_path,thumbnail_path,status,allow_download,created_at"
        )
        .eq("status", "published")
        .order("created_at", { ascending: false })
        .limit(60);

      if (error) throw error;

      const items = await Promise.all(
        (data || []).map(async (item) => {
          const { data: signed, error: signedError } = await supabase.storage
            .from(BUCKET)
            .createSignedUrl(item.storage_path, 3600);

          let thumbnailUrl = "";

          if (item.thumbnail_path) {
            const { data: thumb } = await supabase.storage
              .from("track-covers")
              .createSignedUrl(item.thumbnail_path, 3600);

            thumbnailUrl = thumb?.signedUrl || "";
          }

          return {
            ...item,
            playbackUrl: signedError ? "" : signed?.signedUrl || "",
            thumbnailUrl,
          };
        })
      );

      setMedia(items);
    } catch (error) {
      setMessage(
        "Could not load published media: " +
          (error.message || "Please check your database permissions.")
      );
    } finally {
      setFeedLoading(false);
    }
  }

  async function handleBecomeArtist() {
    if (!session?.user?.id) {
      setMessage("Please sign in first.");
      return;
    }

    setArtistLoading(true);
    setMessage("");

    try {
      const { data, error } = await supabase.rpc("become_artist");

      if (error) throw error;

      setProfile(data);
      setShowArtistStudio(true);
      setMessage("Welcome! Your artist profile is now active.");
    } catch (error) {
      setMessage(
        "Could not activate artist profile: " +
        (error.message || "Unknown error")
      );
    } finally {
      setArtistLoading(false);
    }
  }

  async function handleAuth(event) {
    event.preventDefault();
    setBusy(true);
    setMessage("");

    try {
      if (mode === "register") {
        const { data, error } = await supabase.auth.signUp({
          email: email.trim(),
          password,
          options: {
            data: {
              display_name: displayName.trim(),
              account_type: accountType,
            },
          },
        });

        if (error) throw error;

        if (data.session) {
          setMessage("Account created successfully!");
        } else {
          setMessage(
            "Registration received. Check your email to confirm your account."
          );
          setMode("login");
        }
      } else {
        const { error } = await supabase.auth.signInWithPassword({
          email: email.trim(),
          password,
        });

        if (error) throw error;
        setMessage("Welcome back to Music Antenna!");
      }
    } catch (error) {
      setMessage(error.message || "Authentication failed.");
    } finally {
      setBusy(false);
    }
  }

  async function openChannel(artistId) {
    if (!artistId) {
      setMessage("Channel information is not available for this item.");
      return;
    }
    setChannelLoading(true);
    setShowChannelPage(true);
    setChannelProfile(null);
    setChannelMedia([]);
    window.scrollTo({ top: 0, behavior: "smooth" });

    try {
      const { data: prof, error: profErr } = await supabase
        .from("profiles")
        .select("id,display_name,role,created_at,username,bio,avatar_url,cover_url,updated_at")
        .eq("id", artistId)
        .maybeSingle();

      if (profErr) throw profErr;
      setChannelProfile(prof || { id: artistId, display_name: "Unknown artist" });

      const { data: list, error: listErr } = await supabase
        .from("media")
        .select("id,artist_id,title,description,media_type,storage_path,thumbnail_path,status,allow_download,created_at")
        .eq("artist_id", artistId)
        .eq("status", "published")
        .order("created_at", { ascending: false })
        .limit(60);

      if (listErr) throw listErr;

      const items = await Promise.all(
        (list || []).map(async (item) => {
          const { data: signed } = await supabase.storage
            .from(BUCKET)
            .createSignedUrl(item.storage_path, 3600);
          let thumbnailUrl = "";
          if (item.thumbnail_path) {
            const { data: thumb } = await supabase.storage
              .from("track-covers")
              .createSignedUrl(item.thumbnail_path, 3600);
            thumbnailUrl = thumb?.signedUrl || "";
          }
          return {
            ...item,
            playbackUrl: signed?.signedUrl || "",
            thumbnailUrl,
          };
        })
      );

      setChannelMedia(items);
    } catch (error) {
      setMessage("Could not load channel: " + (error.message || "Unknown error"));
    } finally {
      setChannelLoading(false);
    }
  }

  async function handleLogout() {
    setBusy(true);
    const { error } = await supabase.auth.signOut();
    setMessage(error ? error.message : "Signed out successfully.");
    setBusy(false);
  }


  async function handleSaveProfile(event) {
    event.preventDefault();

    if (!session?.user?.id) {
      setMessage("Please sign in to edit your profile.");
      return;
    }

    const name = profileName.trim();
    if (!name) {
      setMessage("Enter a username or display name.");
      return;
    }

    for (const file of [profilePhotoFile, coverPhotoFile]) {
      if (file && !file.type.startsWith("image/")) {
        setMessage("Choose image files for your profile picture and cover.");
        return;
      }
      if (file && file.size > 5 * 1024 * 1024) {
        setMessage("Each profile image must be 5 MB or smaller.");
        return;
      }
    }

    setProfileSaving(true);
    setMessage("Saving profile...");

    try {
      let avatarUrl = profile?.avatar_url || null;
      let coverUrl = profile?.cover_url || null;

      async function uploadProfileImage(file, kind) {
        if (!file) return null;

        const extension = file.name.split(".").pop().replace(/[^a-zA-Z0-9]/g, "");
        const path = `${session.user.id}/profile-${kind}-${Date.now()}.${extension || "jpg"}`;

        const { error } = await supabase.storage
          .from("track-covers")
          .upload(path, file, {
            contentType: file.type,
            upsert: false,
          });

        if (error) throw error;

        const { data } = supabase.storage
          .from("track-covers")
          .getPublicUrl(path);

        return data.publicUrl;
      }

      if (profilePhotoFile) {
        avatarUrl = await uploadProfileImage(profilePhotoFile, "avatar");
      }

      if (coverPhotoFile) {
        coverUrl = await uploadProfileImage(coverPhotoFile, "cover");
      }

      const { data, error } = await supabase
        .from("profiles")
        .update({
          display_name: name,
          username: name,
          bio: profileBio.trim(),
          avatar_url: avatarUrl,
          cover_url: coverUrl,
          updated_at: new Date().toISOString(),
        })
        .eq("id", session.user.id)
        .select("id,display_name,role,created_at,username,bio,avatar_url,cover_url,updated_at")
        .single();

      if (error) throw error;

      setProfile(data);
      setProfilePhotoFile(null);
      setCoverPhotoFile(null);
      setShowProfileEditor(false);
      setMessage("Profile saved successfully.");
    } catch (error) {
      setMessage("Could not save profile: " + (error.message || "Check your database and image-storage permissions."));
    } finally {
      setProfileSaving(false);
    }
  }

  async function handleUpload(event) {
    event.preventDefault();

    if (!session) {
      setMessage("Please sign in before uploading.");
      return;
    }



    if (!uploadFile || !uploadTitle.trim()) {
      setMessage("Enter a title and select an audio or video file.");
      return;
    }

    const isVideo = uploadFile.type.startsWith("video/");
    const isAudio = uploadFile.type.startsWith("audio/");

    if (!isVideo && !isAudio) {
      setMessage("Choose a supported audio or video file.");
      return;
    }

    if (uploadFile.size > 50 * 1024 * 1024) {
      setMessage("This upload exceeds the bucket's 50 MB file limit.");
      return;
    }

    setBusy(true);
    setMessage("Uploading your media...");

    try {
      const safeName = uploadFile.name.replace(/[^a-zA-Z0-9._-]/g, "_");
      const path =
        session.user.id +
        "/" +
        Date.now() +
        "-" +
        safeName;

      const { error: storageError } = await supabase.storage
        .from(BUCKET)
        .upload(path, uploadFile, {
          contentType: uploadFile.type,
          upsert: false,
        });

      if (storageError) throw storageError;

      const { error: insertError } = await supabase.from("media").insert({
        artist_id: session.user.id,
        title: uploadTitle.trim(),
        description: uploadDescription.trim(),
        media_type: isVideo ? "video" : "audio",
        storage_path: path,
        status: "published",
        allow_download: allowDownload,
      });

      if (insertError) {
        setMessage(
          "The file uploaded, but the media record could not be saved: " +
            insertError.message +
            ". The uploaded file remains in storage."
        );
        return;
      }

      setMessage("Your media was published successfully!");
      setUploadTitle("");
      setUploadDescription("");
      setUploadFile(null);
      setAllowDownload(false);
      setShowUpload(false);

      const fileInput = document.getElementById("media-file");
      if (fileInput) fileInput.value = "";

      await loadMedia();
    } catch (error) {
      setMessage(
        "Upload failed: " +
          (error.message || "Check your storage and database policies.")
      );
    } finally {
      setBusy(false);
    }
  }

  const visibleMedia = media.filter((item) => {
    const query = search.toLowerCase().trim();

    const matchesSearch =
      !query ||
      item.title.toLowerCase().includes(query) ||
      (item.description || "").toLowerCase().includes(query);

    const matchesCategory =
      category === "All" ||
      (category === "Music" && item.media_type === "audio") ||
      (category === "Videos" && item.media_type === "video");

    return matchesSearch && matchesCategory;
  });

  if (loading) {
    return (
      <main className="auth-page">
        <section className="auth-card">
          <div className="auth-logo">♫</div>
          <h1>Music Antenna</h1>
          <p>Connecting securely...</p>
        </section>
      </main>
    );
  }

  if (!session) {
    return (
      <main className="auth-page">
        <section className="auth-card">
          <div className="auth-logo">♫</div>
          <p className="auth-eyebrow">YOUR SOUND. YOUR WORLD.</p>

          <h1>
            {mode === "register" ? "Join Music Antenna" : "Welcome back"}
          </h1>

          <p className="auth-description">
            {mode === "register"
              ? "Create your account and join the music community."
              : "Sign in to discover music and videos."}
          </p>

          <form onSubmit={handleAuth}>
            {mode === "register" && (
              <label>
                Display name
                <input
                  value={displayName}
                  onChange={(e) => setDisplayName(e.target.value)}
                  placeholder="Your artist or display name"
                  maxLength={80}
                  autoComplete="name"
                  required
                />
              </label>
            )}

            {mode === "register" && (
              <fieldset className="account-type-choice" style={{
                border: "1px solid #39445a",
                borderRadius: "12px",
                padding: "14px",
                margin: "0 0 16px",
                textAlign: "left"
              }}>
                <legend>How will you use Music Antenna?</legend>
                <label style={{display:"flex",alignItems:"flex-start",gap:"10px",margin:"10px 0"}}>
                  <input
                    type="radio"
                    name="accountType"
                    value="listener"
                    checked={accountType === "listener"}
                    onChange={() => setAccountType("listener")}
                  />
                  <span><strong>Join as a Listener</strong><br />
                    Discover and listen to music and videos.</span>
                </label>
                <label style={{display:"flex",alignItems:"flex-start",gap:"10px",margin:"10px 0"}}>
                  <input
                    type="radio"
                    name="accountType"
                    value="artist"
                    checked={accountType === "artist"}
                    onChange={() => setAccountType("artist")}
                  />
                  <span><strong>Join as an Artist</strong><br />
                    Create your artist profile and access Artist Studio.</span>
                </label>
              </fieldset>
            )}

            <label>
              Email address
              <input
                type="email"
                value={email}
                onChange={(e) => setEmail(e.target.value)}
                placeholder="you@example.com"
                autoComplete="email"
                required
              />
            </label>

            <label>
              Password
              <input
                type="password"
                value={password}
                onChange={(e) => setPassword(e.target.value)}
                placeholder="At least 8 characters"
                minLength={8}
                autoComplete={
                  mode === "register" ? "new-password" : "current-password"
                }
                required
              />
            </label>

            <button className="auth-submit" disabled={busy}>
              {busy
                ? "Please wait..."
                : mode === "register"
                  ? "Create account"
                  : "Sign in"}
            </button>
          </form>

          {message && (
            <p className="auth-message" role="status">
              {message}
            </p>
          )}

          <p className="auth-switch">
            {mode === "register"
              ? "Already have an account?"
              : "New to Music Antenna?"}{" "}
            <button
              type="button"
              onClick={() => {
                setMode(mode === "register" ? "login" : "register");
                setMessage("");
              }}
            >
              {mode === "register" ? "Sign in" : "Create account"}
            </button>
          </p>

          <p className="auth-footnote">
            Secure accounts powered by Supabase.
          </p>
        </section>
      </main>
    );
  }

  const displayUser =
    session.user.user_metadata?.display_name ||
    session.user.email?.split("@")[0] ||
    "Listener";

  return (
    <div className="ma-app">
      <header className="ma-header">
        <div className="ma-header-left">
          <button className="ma-icon-btn" aria-label="Guide"
            onClick={() => setSidebarCollapsed(!sidebarCollapsed)}>
            <span className="material-symbols-outlined">menu</span>
          </button>
          <a className="ma-brand" href="#home"
            onClick={() => { setActiveMedia(null); setShowAccountPage(false); }}>
            <span className="ma-brand-icon">♫</span>
            <span className="ma-brand-text">Music <b>Antenna</b></span>
          </a>
        </div>

        <div className="ma-search">
          <div className="ma-search-box">
            <input aria-label="Search" placeholder="Search" value={search}
              onChange={(e) => setSearch(e.target.value)} />
            {search && (
              <button className="ma-search-clear" onClick={() => setSearch("")} aria-label="Clear">
                <span className="material-symbols-outlined">close</span>
              </button>
            )}
          </div>
          <button className="ma-search-btn" aria-label="Search">
            <span className="material-symbols-outlined">search</span>
          </button>
          <button className="ma-mic-btn" aria-label="Voice search">
            <span className="material-symbols-outlined">mic</span>
          </button>
        </div>

        <div className="ma-user">
          <button className="ma-icon-btn ma-header-create" aria-label="Create"
            onClick={() => {
              if (profile?.role === "artist") setShowUpload(true);
              else setMessage("Become an Artist before uploading music or videos.");
            }}>
            <span className="material-symbols-outlined">add_box</span>
          </button>

          <button className="ma-icon-btn" aria-label="Notifications"
            onClick={() => setMessage("You're all caught up.")}>
            <span className="material-symbols-outlined">notifications</span>
          </button>

          <div className="ma-avatar-wrap">
            <button className="ma-avatar-btn" onClick={() => setMenuOpen(!menuOpen)} aria-label="Account">
              {profile?.avatar_url ? (
                <img className="ma-avatar-img" src={profile.avatar_url} alt="" onError={(e) => { e.currentTarget.style.display = "none"; }} />
              ) : (
                <span className="ma-avatar">{displayUser.charAt(0).toUpperCase()}</span>
              )}
            </button>

            {menuOpen && (
              <>
                <div className="ma-menu-backdrop" onClick={() => setMenuOpen(false)} />
                <div className="ma-avatar-menu" role="menu">
                  <div className="ma-avatar-menu-header">
                    {profile?.avatar_url ? (
                      <img className="ma-avatar-menu-img" src={profile.avatar_url} alt="" />
                    ) : (
                      <span className="ma-avatar-menu-img ma-avatar-menu-placeholder">
                        {displayUser.charAt(0).toUpperCase()}
                      </span>
                    )}
                    <div>
                      <strong>{profile?.display_name || displayUser}</strong>
                      <span>@{profile?.username || profile?.display_name || "music-antenna"}</span>
                    </div>
                  </div>
                  <div className="ma-avatar-menu-line" />
                  <button onClick={() => { setMenuOpen(false); setShowAccountPage(true); setShowProfileEditor(false); window.scrollTo({ top: 0, behavior: "smooth" }); }}>
                    <span className="material-symbols-outlined">account_circle</span> Your channel
                  </button>
                  <button onClick={() => { setMenuOpen(false); setProfileName(profile?.username || profile?.display_name || ""); setProfileBio(profile?.bio || ""); setShowAccountPage(true); setShowProfileEditor(true); window.scrollTo({ top: 0, behavior: "smooth" }); }}>
                    <span className="material-symbols-outlined">edit</span> Edit profile
                  </button>
                  <div className="ma-avatar-menu-line" />
                  <button onClick={() => { setMenuOpen(false); handleLogout(); }}>
                    <span className="material-symbols-outlined">logout</span> Sign out
                  </button>
                </div>
              </>
            )}
          </div>
        </div>
      </header>

      <div className={"ma-layout" + (sidebarCollapsed ? " ma-layout-collapsed" : "") + ((showAccountPage || showChannelPage) ? " ma-layout-hidden" : "")}>
        <aside className="ma-sidebar">
          <button
            className="ma-nav-item selected"
            onClick={() => {
              setActiveMedia(null);
              setCategory("All");
            }}
          >
            <span>⌂</span> Home
          </button>

          <button
            className="ma-nav-item"
            onClick={() => {
              setActiveMedia(null);
              setCategory("Music");
            }}
          >
            <span>♫</span> Music
          </button>

          <button
            className="ma-nav-item"
            onClick={() => {
              setActiveMedia(null);
              setCategory("Videos");
            }}
          >
            <span>▶</span> Videos
          </button>

          <div className="ma-sidebar-line" />

          {profile?.role !== "artist" && (
            <button
              className="ma-nav-item"
              onClick={handleBecomeArtist}
              disabled={artistLoading || !profile}
            >
              <span>🎤</span>{" "}
              {artistLoading ? "Please wait..." : "Become an Artist"}
            </button>
          )}

          {profile?.role === "artist" && (
            <button
              className="ma-nav-item"
              onClick={() => {
                setShowArtistStudio(!showArtistStudio);
                setShowUpload(true);
              }}
            >
              <span>🎚</span> Artist Studio
            </button>
          )}

          <button
            className="ma-nav-item"
            onClick={() => setShowUpload(!showUpload)}
          >
            <span>＋</span> Upload media
          </button>

          <div className="ma-sidebar-bottom">
            <span className="ma-brand-icon">♫</span>
            <p>Music Antenna</p>
            <small>Your sound. Your world.</small>
          </div>
        </aside>

        <main className="ma-main" id="home">
          {showArtistStudio && profile?.role === "artist" && (
            <section className="ma-upload-panel" id="media-upload-panel">
              <div className="ma-section-heading ma-hide-desktop-only">
                <div>
                  <p className="ma-kicker">ARTIST STUDIO</p>
                  <h2>Welcome, {profile.display_name || displayUser}!</h2>
                </div>
                <button
                  className="ma-close"
                  onClick={() => setShowArtistStudio(false)}
                  aria-label="Close Artist Studio"
                >
                  ×
                </button>
              </div>

              <p className="ma-muted">
                Your artist profile is active. Upload your music or videos
                and share your work with Music Antenna listeners.
              </p>

              <button
                className="ma-primary"
                onClick={() => {
                  setShowUpload(true);
                  document
                    .getElementById("media-upload-panel")
                    ?.scrollIntoView({ behavior: "smooth" });
                }}
              >
                Upload music or video →
              </button>
            </section>
          )}

          <section className="ma-hero ma-discovery-hero ma-hero-hidden">
            <div className="ma-discovery-copy">
              <p className="ma-hero-label">MUSIC ANTENNA</p>
              <h1>Discover your sound.</h1>
              <p>Search for any artist, song or music video to get started.</p>
              <div className="ma-discovery-actions">
                <button className="ma-primary"
                  onClick={() => setShowUpload(true)}>
                  ＋ Upload media
                </button>
                <button className="ma-discovery-browse"
                  onClick={() => document.getElementById("media-feed")
                    ?.scrollIntoView({ behavior: "smooth" })}>
                  Browse latest ↓
                </button>
              </div>
            </div>
            <div className="ma-hero-art" aria-hidden="true">
              <span>♫</span><i>♪</i><b>♬</b>
            </div>
          </section>


{showUpload && (
            <section className="ma-upload-panel">
              <div className="ma-section-heading ma-hide-desktop-only">
                <div>
                  <p className="ma-kicker">CREATOR STUDIO</p>
                  <h2>Upload your music or video</h2>
                </div>
                <button
                  className="ma-close"
                  onClick={() => setShowUpload(false)}
                  aria-label="Close upload form"
                >
                  ×
                </button>
              </div>

              <p className="ma-muted">
                Current storage limit: 50 MB per file. Uploaded files will be
                published if your account has the required database and storage
                permissions.
              </p>

              <form className="ma-upload-form" onSubmit={handleUpload}>
                <label>
                  Title
                  <input
                    value={uploadTitle}
                    onChange={(e) => setUploadTitle(e.target.value)}
                    maxLength={200}
                    placeholder="Give your upload a title"
                    required
                  />
                </label>

                <label>
                  Description
                  <textarea
                    value={uploadDescription}
                    onChange={(e) => setUploadDescription(e.target.value)}
                    placeholder="Tell listeners about your upload"
                    rows={3}
                  />
                </label>

                <label>
                  Audio or video file
                  <input
                    id="media-file"
                    type="file"
                    accept="audio/mpeg,audio/mp4,audio/aac,audio/ogg,audio/wav,audio/flac,video/mp4,video/webm,video/quicktime"
                    onChange={(e) =>
                      setUploadFile(e.target.files?.[0] || null)
                    }
                    required
                  />
                </label>

                <label className="ma-checkbox">
                  <input
                    type="checkbox"
                    checked={allowDownload}
                    onChange={(e) => setAllowDownload(e.target.checked)}
                  />
                  Allow downloads (download links are not enabled yet)
                </label>

                <button className="ma-primary" disabled={busy}>
                  {busy ? "Please wait..." : "Upload and publish"}
                </button>
              </form>
            </section>
          )}

          {activeMedia && (
            <section className="ma-player-panel">
              <button
                className="ma-back"
                onClick={() => setActiveMedia(null)}
              >
                ← Back to feed
              </button>

              {activeMedia.playbackUrl ? (
                activeMedia.media_type === "video" ? (
                  <video
                    className="ma-player"
                    src={activeMedia.playbackUrl}
                    poster={activeMedia.thumbnailUrl || undefined}
                    controls
                    playsInline
                    autoPlay
                  />
                ) : (
                  <div className="ma-audio-player">
                    <div className="ma-audio-art">♫</div>
                    <audio
                      src={activeMedia.playbackUrl}
                      controls
                      autoPlay
                    />
                  </div>
                )
              ) : (
                <p className="ma-message">
                  Playback is unavailable. Check the storage bucket policies
                  and media storage path.
                </p>
              )}

              <h2>{activeMedia.title}</h2>
              <p className="ma-muted">
                {activeMedia.description || "No description provided."}
              </p>

              <div className="ma-player-actions">
                <button
                  className="ma-secondary"
                  onClick={async () => {
                    const shareUrl = window.location.href.split("#")[0];
                    try {
                      await navigator.clipboard.writeText(shareUrl);
                      setMessage("Page link copied. Share it with your friends.");
                    } catch {
                      setMessage("Copy this page address to share it.");
                    }
                  }}
                >
                  ↗ Share page
                </button>
              </div>
            </section>
          )}

          <section className="ma-feed-section" id="media-feed">
            <div className="ma-section-heading ma-hide-desktop-only">
              <div>
                <p className="ma-kicker">THE COMMUNITY</p>
                <h2>{category === "All" ? "Explore media" : category}</h2>
              </div>
              <button
                className="ma-refresh"
                onClick={loadMedia}
                disabled={feedLoading}
              >
                ↻ Refresh
              </button>
            </div>

            <div className="yt-chips">
              {["All", "Music", "Videos"].map((c) => (
                <button
                  key={c}
                  className={"yt-chip" + (category === c ? " yt-chip-active" : "")}
                  onClick={() => {
                    setCategory(c);
                    setActiveMedia(null);
                  }}
                >
                  {c}
                </button>
              ))}
            </div>

            {message && <p className="ma-message">{message}</p>}

            {feedLoading ? (
              <div className="ma-empty">
                <span className="ma-spinner">♫</span>
                <h3>Loading your feed...</h3>
                <p>Fetching published media from Supabase.</p>
              </div>
            ) : visibleMedia.length === 0 ? (
              <div className="ma-empty">
                <span className="ma-empty-icon">♫</span>
                <h3>
                  {search ? "No matching media found" : "Discover your sound"}
                </h3>
                <p>
                  {search
                    ? "Try another search term."
                    : "Search for an artist, song or music video. Newly published tracks and videos will appear here."}
                </p>
                {!search && (
                  <button
                    className="ma-primary"
                    onClick={() => setShowUpload(true)}
                  >
                    ＋ Upload media
                  </button>
                )}
              </div>
            ) : (
              <div className="ma-media-grid">
                {visibleMedia.map((item) => (
                  <article className="yt-video" key={item.id}>
                    <button
                      className="yt-thumb"
                      onClick={() => openPlayer(item)}
                      aria-label={"Play " + item.title}
                    >
                      {item.thumbnailUrl ? (
                        <img src={item.thumbnailUrl} alt="" loading="lazy" />
                      ) : (
                        <div className="yt-thumb-fallback">
                          <span>{item.media_type === "video" ? "▶" : "♫"}</span>
                        </div>
                      )}
                      <span className="yt-duration">
                        {item.media_type === "video" ? "VIDEO" : "AUDIO"}
                      </span>
                    </button>

                    <div className="yt-video-row">
                      <div className="yt-video-avatar">♫</div>
                      <div className="yt-video-info">
                        <h3 className="yt-video-title">{item.title}</h3>
                        <p className="yt-video-channel">
                          {item.description || "Music Antenna"}
                        </p>
                        <p className="yt-video-meta">
                          {new Date(item.created_at).toLocaleDateString()}
                        </p>
                      </div>
                      <button className="yt-video-menu" aria-label="More">⋮</button>
                    </div>
                  </article>
                ))}
              </div>
            )}
          </section>

          <footer className="ma-footer">
            <span>♫ Music Antenna</span>
            <span>Your sound. Your world.</span>
          </footer>
        </main>
      </div>


      {showAccountPage && (
        <section className="yt-you">
          <div className="yt-you-topbar">
            <button
              className="yt-you-accounts"
              onClick={() => setMenuOpen(!menuOpen)}
            >
              <span>{profile?.display_name || displayUser}</span>
              <span className="material-symbols-outlined">expand_more</span>
            </button>
            <div className="yt-you-topbar-right">
              <button
                className="yt-icon-btn"
                aria-label="Notifications"
                onClick={() => setMessage("You're all caught up.")}
              >
                <span className="material-symbols-outlined">notifications</span>
              </button>
              <button className="yt-icon-btn" aria-label="Search"
                onClick={() => { setShowAccountPage(false); window.scrollTo({ top: 0, behavior: "smooth" }); }}>
                <span className="material-symbols-outlined">search</span>
              </button>
              <button className="yt-icon-btn" aria-label="Settings"
                onClick={() => setMessage("Settings coming in Phase 5.")}>
                <span className="material-symbols-outlined">settings</span>
              </button>
            </div>
          </div>

          <div className="yt-you-identity">
            <div className="yt-you-avatar yt-you-avatar-fallback yt-you-avatar-wrap">
              {(profile?.display_name || displayUser || "M").charAt(0).toUpperCase()}
              {profile?.avatar_url && (
                <img
                  className="yt-you-avatar-img"
                  src={profile.avatar_url}
                  alt=""
                  onError={(e) => { e.currentTarget.style.display = "none"; }}
                />
              )}
            </div>
            <h2>{profile?.display_name || displayUser || "Music listener"}</h2>
            <p className="yt-you-handle">
              @{profile?.username || profile?.display_name || "music-antenna-user"}
            </p>
            <p className="yt-you-bio">
              {profile?.bio || "Welcome to my Music Antenna channel."}
            </p>
          </div>

          <div className="yt-you-actions">
            <button
              className="yt-you-btn yt-you-btn-primary"
              onClick={() => {
                if (session?.user?.id) {
                  setShowAccountPage(false);
                  openChannel(session.user.id);
                } else {
                  setMessage("Please sign in to view your channel.");
                }
              }}
            >
              View channel
            </button>
            <button
              className="yt-you-btn yt-you-btn-secondary"
              onClick={() => {
                setProfileName(profile?.username || profile?.display_name || "");
                setProfileBio(profile?.bio || "");
                setProfilePhotoFile(null);
                setCoverPhotoFile(null);
                setShowProfileEditor(!showProfileEditor);
              }}
            >
              {showProfileEditor ? "Close editor" : "Edit profile"}
            </button>
          </div>

          {showProfileEditor && (
            <section className="ma-upload-panel yt-you-editor">
              <h2>Edit your profile</h2>
              <p>Update your name, bio, profile picture and cover photo.</p>

              {profile?.avatar_url && (
                <p>
                  Current profile picture:<br />
                  <img
                    src={profile.avatar_url}
                    alt="Current profile"
                    style={{ width: 88, height: 88, objectFit: "cover", borderRadius: "50%" }}
                  />
                </p>
              )}

              {profile?.cover_url && (
                <p>
                  Current cover photo:<br />
                  <img
                    src={profile.cover_url}
                    alt="Current profile cover"
                    style={{ width: "100%", maxHeight: 180, objectFit: "cover", borderRadius: 10 }}
                  />
                </p>
              )}

              <form className="ma-upload-form" onSubmit={handleSaveProfile}>
                <label>
                  Username / display name
                  <input
                    type="text"
                    value={profileName}
                    onChange={(e) => setProfileName(e.target.value)}
                    maxLength={60}
                    required
                    placeholder="Your name"
                  />
                </label>

                <label>
                  Bio / about you
                  <textarea
                    value={profileBio}
                    onChange={(e) => setProfileBio(e.target.value)}
                    maxLength={500}
                    rows={3}
                    placeholder="Tell listeners about yourself"
                  />
                </label>

                <label>
                  Profile picture
                  <input
                    type="file"
                    accept="image/*"
                    onChange={(e) => setProfilePhotoFile(e.target.files?.[0] || null)}
                  />
                </label>

                <label>
                  Cover photo
                  <input
                    type="file"
                    accept="image/*"
                    onChange={(e) => setCoverPhotoFile(e.target.files?.[0] || null)}
                  />
                </label>

                <button type="submit" disabled={profileSaving}>
                  {profileSaving ? "Saving..." : "Save Profile"}
                </button>
              </form>
            </section>
          )}

          {history.length > 0 && (
            <div className="yt-you-shelf">
              <div className="yt-you-shelf-head">
                <h3>History</h3>
                <span className="material-symbols-outlined">chevron_right</span>
              </div>
              <div className="yt-you-shelf-row">
                {history.map((item) => (
                  <button
                    className="yt-you-shelf-card"
                    key={item.id}
                    onClick={() => {
                      const found = media.find((m) => m.id === item.id);
                      if (found) {
                        openPlayer(found);
                      } else {
                        setMessage("This item is no longer available.");
                      }
                    }}
                  >
                    <div className="yt-you-shelf-thumb">
                      {item.thumbnailUrl ? (
                        <img src={item.thumbnailUrl} alt="" />
                      ) : (
                        <div className="yt-thumb-fallback">
                          <span>{item.media_type === "video" ? "▶" : "♫"}</span>
                        </div>
                      )}
                    </div>
                    <p className="yt-you-shelf-title">{item.title}</p>
                  </button>
                ))}
              </div>
            </div>
          )}

          <h3 className="yt-you-section-title yt-you-library-title">Library</h3>
          <div className="yt-you-chips">
            {["Recents", "Music", "Videos", "Playlists"].map((c) => (
              <button key={c} className="yt-chip">
                {c}
              </button>
            ))}
          </div>

          <button
            type="button"
            className="yt-you-liked-row"
            onClick={() => setMessage(
              likedIds.length === 0
                ? "You haven't liked any videos yet."
                : "You have " + likedIds.length + " liked videos."
            )}
          >
            <div className="yt-you-liked-thumb">
              <span className="material-symbols-outlined">thumb_up</span>
            </div>
            <div className="yt-you-liked-info">
              <h4>Liked videos</h4>
              <p>{likedIds.length === 0 ? "Private" : likedIds.length + " videos · Private"}</p>
            </div>
          </button>

          <div className="yt-you-section">
            <h3 className="yt-you-section-title">Your videos</h3>
            {session?.user?.id && media.filter((m) => m.artist_id === session.user.id).length > 0 ? (
              <div className="ma-media-grid">
                {media
                  .filter((m) => m.artist_id === session.user.id)
                  .map((item) => (
                    <article className="yt-video" key={item.id}>
                      <button
                        className="yt-thumb"
                        onClick={() => openPlayer(item)}
                        aria-label={"Play " + item.title}
                      >
                        {item.thumbnailUrl ? (
                          <img src={item.thumbnailUrl} alt="" loading="lazy" />
                        ) : (
                          <div className="yt-thumb-fallback">
                            <span>{item.media_type === "video" ? "▶" : "♫"}</span>
                          </div>
                        )}
                        <span className="yt-duration">
                          {item.media_type === "video" ? "VIDEO" : "AUDIO"}
                        </span>
                      </button>
                      <div className="yt-video-row">
                        <div className="yt-video-avatar">♫</div>
                        <div className="yt-video-info">
                          <h3 className="yt-video-title">{item.title}</h3>
                          <button
                            type="button"
                            className="yt-video-channel yt-video-channel-btn"
                            onClick={(e) => {
                              e.stopPropagation();
                              openChannel(item.artist_id);
                            }}
                          >
                            {item.description || "Music Antenna"}
                          </button>
                          <p className="yt-video-meta">
                            {new Date(item.created_at).toLocaleDateString()}
                          </p>
                        </div>
                      </div>
                    </article>
                  ))}
              </div>
            ) : (
              <p className="yt-you-empty">No uploads yet.</p>
            )}
          </div>
        </section>
      )}

            {showChannelPage && (
        <section className="yt-channel">
          <div className="yt-channel-topbar">
            <button
              className="yt-icon-btn"
              aria-label="Back"
              onClick={() => {
                setShowChannelPage(false);
                setChannelProfile(null);
                setChannelMedia([]);
              }}
            >
              <span className="material-symbols-outlined">arrow_back</span>
            </button>
            <div className="yt-channel-topbar-right">
              <button className="yt-icon-btn" aria-label="Search"
                onClick={() => { setShowChannelPage(false); window.scrollTo({ top: 0, behavior: "smooth" }); }}>
                <span className="material-symbols-outlined">search</span>
              </button>
              <button className="yt-icon-btn" aria-label="More">
                <span className="material-symbols-outlined">more_vert</span>
              </button>
            </div>
          </div>

          {channelLoading ? (
            <div className="yt-you-empty">Loading channel…</div>
          ) : channelProfile ? (
            <>
              <div className="yt-channel-banner">
                {channelProfile.cover_url ? (
                  <img src={channelProfile.cover_url} alt="" />
                ) : (
                  <div className="yt-channel-banner-placeholder" />
                )}
              </div>

              <div className="yt-channel-head">
                <div className="yt-channel-avatar-wrap">
                  {channelProfile.avatar_url ? (
                    <img
                      className="yt-channel-avatar-img"
                      src={channelProfile.avatar_url}
                      alt=""
                      onError={(e) => { e.currentTarget.style.display = "none"; }}
                    />
                  ) : null}
                  <div className="yt-channel-avatar-fallback">
                    {(channelProfile.display_name || "M").charAt(0).toUpperCase()}
                  </div>
                </div>

                <div className="yt-channel-meta">
                  <h1>{channelProfile.display_name || "Unknown artist"}</h1>
                  <p className="yt-channel-sub">
                    @{channelProfile.username || channelProfile.display_name || "music-antenna"} · {channelMedia.length} {channelMedia.length === 1 ? "upload" : "uploads"}
                  </p>
                  <p className="yt-channel-subscribers">
                    0 subscribers
                  </p>
                  <p className="yt-channel-bio">
                    {channelProfile.bio || "Welcome to my Music Antenna channel."}
                  </p>
                </div>
              </div>

              <div className="yt-channel-actions">
                {channelProfile.id === session?.user?.id ? (
                  <>
                    <button
                      type="button"
                      className="yt-you-btn yt-you-btn-secondary"
                      onClick={() => {
                        setShowChannelPage(false);
                        setShowAccountPage(true);
                        setProfileName(profile?.username || profile?.display_name || "");
                        setProfileBio(profile?.bio || "");
                        setProfilePhotoFile(null);
                        setCoverPhotoFile(null);
                        setShowProfileEditor(true);
                        window.scrollTo({ top: 0, behavior: "smooth" });
                      }}
                    >
                      <span className="material-symbols-outlined" style={{ fontSize: 18, verticalAlign: "middle", marginRight: 6 }}>edit</span>
                      Edit channel
                    </button>
                    <button
                      type="button"
                      className="yt-you-btn yt-you-btn-secondary"
                      onClick={() => setMessage("Analytics coming soon.")}
                    >
                      <span className="material-symbols-outlined" style={{ fontSize: 18, verticalAlign: "middle", marginRight: 6 }}>bar_chart</span>
                      Analytics
                    </button>
                  </>
                ) : (
                  <>
                    <button
                      type="button"
                      className="yt-you-btn yt-you-btn-primary"
                      onClick={() => setMessage("Subscriptions coming soon.")}
                    >
                      Subscribe
                    </button>
                    <button
                      type="button"
                      className="yt-you-btn yt-you-btn-secondary"
                      onClick={() => setMessage("Join coming soon.")}
                    >
                      Join
                    </button>
                  </>
                )}
              </div>

              <div className="yt-channel-tabs">
                {["Home", "Videos", "Shorts", "Playlists", "About"].map((t) => (
                  <button
                    key={t}
                    className={"yt-channel-tab" + (channelTab === t ? " yt-channel-tab-active" : "")}
                    onClick={() => setChannelTab(t)}
                  >
                    {t}
                  </button>
                ))}
              </div>

              {channelMedia.length > 0 ? (
                <div className="ma-media-grid">
                  {channelMedia.map((item) => (
                    <article className="yt-video" key={item.id}>
                      <button
                        className="yt-thumb"
                        onClick={() => openPlayer(item)}
                        aria-label={"Play " + item.title}
                      >
                        {item.thumbnailUrl ? (
                          <img src={item.thumbnailUrl} alt="" loading="lazy" />
                        ) : (
                          <div className="yt-thumb-fallback">
                            <span>{item.media_type === "video" ? "▶" : "♫"}</span>
                          </div>
                        )}
                        <span className="yt-duration">
                          {item.media_type === "video" ? "VIDEO" : "AUDIO"}
                        </span>
                      </button>
                      <div className="yt-video-row">
                        <div className="yt-video-avatar">♫</div>
                        <div className="yt-video-info">
                          <h3 className="yt-video-title">{item.title}</h3>
                          <p className="yt-video-meta">
                            {new Date(item.created_at).toLocaleDateString()}
                          </p>
                        </div>
                      </div>
                    </article>
                  ))}
                </div>
              ) : (
                <p className="yt-you-empty">This artist hasn't uploaded anything yet.</p>
              )}
            </>
          ) : (
            <p className="yt-you-empty">Channel not found.</p>
          )}
        </section>
      )}

<nav className={"ma-mobile-nav ma-nav-yt" + (navVisible ? "" : " ma-mobile-nav-hidden")} aria-label="Main navigation">
        <button aria-label="Home" onClick={() => {
          setActiveMedia(null);
          setCategory("All");
          setSearch("");
          setShowAccountPage(false);
          window.scrollTo({ top: 0, behavior: "smooth" });
        }}>
          <span className="material-symbols-outlined">home</span>
          <small>Home</small>
        </button>

        <button aria-label="Shorts" onClick={() => {
          setActiveMedia(null);
          setCategory("Videos");
          setShowAccountPage(false);
        }}>
          <span className="material-symbols-outlined">video_library</span>
          <small>Shorts</small>
        </button>

        <button className="ma-create-nav" aria-label="Create" onClick={() => {
          if (profile?.role === "artist") {
            setShowUpload(true);
          } else {
            setMessage("Become an Artist before uploading music or videos.");
          }
        }}>
          <span className="material-symbols-outlined">add</span>
        </button>

        <button aria-label="Subscriptions" onClick={() => {
          setMessage("Subscriptions are not connected yet.");
        }}>
          <span className="material-symbols-outlined">subscriptions</span>
          <small>Subscriptions</small>
        </button>

        <button aria-label="You" onClick={() => {
          setShowAccountPage(true);
          setShowProfileEditor(false);
          setProfileName(profile?.username || profile?.display_name || "");
          setProfileBio(profile?.bio || "");
          window.scrollTo({ top: 0, behavior: "smooth" });
        }}>
          {profile?.avatar_url ? (
            <img className="ma-nav-avatar" src={profile.avatar_url} alt="" onError={(e) => { e.currentTarget.style.display = "none"; }} />
          ) : (
            <span className="ma-nav-avatar ma-nav-avatar-fallback">
              {displayUser.charAt(0).toUpperCase()}
            </span>
          )}
          <small>You</small>
        </button>
      </nav>
    </div>
  );
}
