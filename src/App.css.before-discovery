@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap');

:root {
  font-family: 'DM Sans', sans-serif;
  color: #f5f6fb;
  background: #090b12;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  --accent: #ff365f;
  --panel: #121520;
  --muted: #9ca3b6;
  --border: #282c3b;
}

* { box-sizing: border-box; }

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
}

button, input, textarea { font: inherit; }
button { cursor: pointer; }
button:disabled { opacity: .6; cursor: wait; }

.auth-page {
  min-height: 100vh;
  display: grid;
  place-items: center;
  padding: 24px;
  background:
    radial-gradient(ellipse at 20% 15%, #38203c 0, transparent 45%),
    radial-gradient(ellipse at 90% 90%, #19254c 0, transparent 40%),
    #090b12;
}

.auth-card {
  width: min(100%, 440px);
  padding: 36px;
  border: 1px solid var(--border);
  border-radius: 24px;
  background: rgba(18, 21, 32, .96);
  box-shadow: 0 24px 80px #0007;
}

.auth-logo, .ma-brand-icon {
  display: inline-grid;
  place-items: center;
  width: 48px;
  height: 48px;
  border-radius: 15px;
  color: white;
  background: linear-gradient(135deg, #ff365f, #a43dff);
  font-size: 28px;
  font-weight: 800;
}

.auth-card h1 {
  font-family: Manrope, sans-serif;
  font-size: 30px;
  margin: 12px 0;
  overflow-wrap: anywhere;
}

.auth-eyebrow, .ma-kicker, .ma-hero-label {
  color: #ff7190;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 2px;
}

.auth-description, .auth-footnote { color: var(--muted); line-height: 1.6; }

.auth-card form, .ma-upload-form {
  display: grid;
  gap: 17px;
  margin-top: 24px;
}

.auth-card label, .ma-upload-form label {
  display: grid;
  gap: 8px;
  font-size: 13px;
  font-weight: 600;
}

.auth-card input, .ma-upload-form input:not([type="checkbox"]),
.ma-upload-form textarea {
  width: 100%;
  min-width: 0;
  padding: 13px 14px;
  border: 1px solid #303548;
  border-radius: 11px;
  outline: none;
  color: #fff;
  background: #0b0e17;
}

.auth-card input:focus, .ma-upload-form input:focus,
.ma-upload-form textarea:focus { border-color: var(--accent); }

.auth-submit, .ma-primary {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  gap: 14px;
  padding: 13px 19px;
  border: 0;
  border-radius: 11px;
  color: #fff;
  background: linear-gradient(120deg, #ff365f, #ed476f);
  font-weight: 800;
  box-shadow: 0 8px 24px #ff365f25;
}

.auth-submit { width: 100%; }

.auth-switch { margin-top: 22px; font-size: 13px; color: var(--muted); }
.auth-switch button {
  border: 0;
  color: #ff7793;
  background: none;
  font-weight: 800;
}
.auth-footnote { margin-top: 24px; font-size: 11px; }
.auth-message, .ma-message {
  padding: 12px 14px;
  border: 1px solid #49405c;
  border-radius: 10px;
  color: #e8d7ff;
  background: #231b32;
  overflow-wrap: anywhere;
}

.ma-app { min-height: 100vh; background: #090b12; }

.ma-header {
  position: sticky;
  z-index: 20;
  top: 0;
  display: flex;
  align-items: center;
  gap: 30px;
  min-height: 76px;
  padding: 12px 4%;
  border-bottom: 1px solid var(--border);
  background: #0c0e17f5;
  backdrop-filter: blur(18px);
}

.ma-brand {
  display: flex;
  align-items: center;
  gap: 10px;
  color: #fff;
  text-decoration: none;
  white-space: nowrap;
  font-family: Manrope, sans-serif;
  font-size: 18px;
  font-weight: 600;
}
.ma-brand-icon { width: 39px; height: 39px; border-radius: 12px; font-size: 23px; }
.ma-brand b { color: #ff6a88; }

.ma-search {
  display: flex;
  align-items: center;
  gap: 12px;
  width: min(500px, 45vw);
  margin: 0 auto;
  padding: 0 16px;
  border: 1px solid #292d3d;
  border-radius: 14px;
  color: #aeb3c5;
  background: #151824;
}
.ma-search input {
  width: 100%;
  min-width: 0;
  padding: 13px 0;
  border: 0;
  outline: 0;
  color: #fff;
  background: transparent;
}
.ma-search button { border: 0; color: #fff; background: transparent; font-size: 20px; }

.ma-user { display: flex; align-items: center; gap: 9px; }
.ma-avatar, .ma-card-avatar {
  display: grid;
  flex: 0 0 auto;
  place-items: center;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  color: white;
  background: linear-gradient(135deg, #ff365f, #8a4bff);
  font-weight: 800;
}
.ma-user-name { max-width: 130px; overflow: hidden; text-overflow: ellipsis; }
.ma-logout, .ma-secondary, .ma-refresh, .ma-back {
  padding: 9px 12px;
  border: 1px solid var(--border);
  border-radius: 10px;
  color: #e8eaf3;
  background: #171a26;
}

.ma-layout { display: grid; grid-template-columns: 220px minmax(0, 1fr); }

.ma-sidebar {
  position: sticky;
  top: 76px;
  display: flex;
  flex-direction: column;
  height: calc(100vh - 76px);
  padding: 24px 14px;
  border-right: 1px solid var(--border);
}

.ma-nav-item {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 14px 15px;
  margin-bottom: 6px;
  border: 0;
  border-radius: 12px;
  color: #aeb3c5;
  background: transparent;
  text-align: left;
}
.ma-nav-item span { width: 24px; text-align: center; font-size: 21px; }
.ma-nav-item:hover, .ma-nav-item.selected { color: #fff; background: #27202e; }
.ma-nav-item.selected { box-shadow: inset 3px 0 #ff365f; }
.ma-sidebar-line { height: 1px; margin: 17px 8px; background: var(--border); }
.ma-sidebar-bottom { margin-top: auto; padding: 18px 10px; color: #fff; }
.ma-sidebar-bottom p { margin-bottom: 5px; font-weight: 700; }
.ma-sidebar-bottom small { color: var(--muted); font-size: 11px; }

.ma-main { min-width: 0; max-width: 1600px; width: 100%; margin: auto; padding: 30px 4% 20px; }

.ma-hero {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 260px;
  overflow: hidden;
  padding: 38px 5%;
  border: 1px solid #393044;
  border-radius: 24px;
  background:
    radial-gradient(ellipse at 85% 45%, #7c2857 0, transparent 40%),
    linear-gradient(120deg, #201628, #171a2c 75%);
}
.ma-hero > div:first-child { position: relative; z-index: 1; }
.ma-hero h1 { max-width: 550px; margin: 12px 0; font: 800 clamp(26px, 3vw, 42px)/1.15 Manrope, sans-serif; }
.ma-hero p:not(.ma-hero-label) { color: #c1bfd0; }
.ma-hero-art { position: relative; width: 200px; height: 180px; flex: 0 0 200px; }
.ma-hero-art span { position: absolute; top: 0; left: 30px; font-size: 155px; color: #ff6388; text-shadow: 0 15px 55px #ff365f70; }
.ma-hero-art i { position: absolute; right: 0; top: 15px; font-size: 70px; color: #e4a7ff; }
.ma-hero-art b { position: absolute; right: 0; bottom: 0; font-size: 65px; color: #fff; }

.ma-section-heading { display: flex; justify-content: space-between; align-items: center; gap: 14px; margin-bottom: 18px; }
.ma-section-heading h2 { margin: 5px 0 0; font: 800 25px Manrope, sans-serif; }
.ma-kicker { margin: 0; font-size: 10px; }
.ma-feed-section { padding-top: 34px; }
.ma-categories { display: flex; flex-wrap: wrap; gap: 9px; margin-bottom: 24px; }
.ma-chip { padding: 9px 17px; border: 1px solid #2b2f3e; border-radius: 999px; color: #c3c6d2; background: #141722; }
.ma-chip-active { border-color: #ff365f; color: #fff; background: #7b263d; }

.ma-media-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px 18px; }
.ma-media-card { min-width: 0; overflow: hidden; border: 1px solid #222635; border-radius: 16px; background: #11141e; transition: transform .2s, border-color .2s; }
.ma-media-card:hover { transform: translateY(-3px); border-color: #494054; }
.ma-thumbnail {
  position: relative;
  display: grid;
  place-items: center;
  width: 100%;
  aspect-ratio: 16 / 9;
  overflow: hidden;
  padding: 0;
  border: 0;
  color: white;
  background: linear-gradient(135deg, #38203c, #202d50);
}
.ma-thumbnail img { width: 100%; height: 100%; object-fit: cover; }
.ma-thumbnail-art { font-size: 75px; color: #ff6d91; }
.ma-play-button {
  position: absolute;
  display: grid;
  place-items: center;
  width: 45px;
  height: 45px;
  border-radius: 50%;
  color: #fff;
  background: #090b12b8;
  border: 1px solid #ffffff80;
  opacity: .95;
}
.ma-media-type { position: absolute; right: 10px; bottom: 10px; padding: 5px 8px; border-radius: 6px; font-size: 9px; letter-spacing: 1px; background: #090b12d9; }
.ma-card-info { display: flex; gap: 11px; padding: 15px 13px 8px; }
.ma-card-avatar { width: 34px; height: 34px; font-size: 19px; }
.ma-card-text { min-width: 0; }
.ma-card-text h3 { display: -webkit-box; overflow: hidden; margin: 0 0 7px; font-size: 15px; line-height: 1.4; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow-wrap: anywhere; }
.ma-card-text p { display: -webkit-box; overflow: hidden; margin: 0 0 7px; color: #a3a8b8; font-size: 12px; line-height: 1.5; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.ma-card-text small { color: #7f8598; font-size: 11px; }
.ma-card-open { width: calc(100% - 26px); margin: 10px 13px 14px; padding: 10px; border: 1px solid #343041; border-radius: 9px; color: #ff91a8; background: #1b1724; font-size: 12px; font-weight: 700; }

.ma-empty { display: grid; justify-items: center; padding: 60px 18px; border: 1px dashed #343041; border-radius: 18px; text-align: center; background: #10121b; }
.ma-empty-icon, .ma-spinner { font-size: 42px; color: #ff6388; }
.ma-empty h3 { margin-bottom: 5px; font: 700 19px Manrope, sans-serif; }
.ma-empty p, .ma-muted { color: var(--muted); line-height: 1.6; font-size: 13px; }
.ma-empty .ma-primary { margin-top: 14px; }

.ma-upload-panel, .ma-player-panel { margin-top: 25px; padding: 25px; border: 1px solid var(--border); border-radius: 18px; background: #11141e; }
.ma-upload-form { max-width: 680px; }
.ma-upload-form textarea { resize: vertical; }
.ma-upload-form input[type="file"] { padding: 12px; }
.ma-checkbox { display: flex !important; grid-template-columns: auto 1fr; align-items: center; }
.ma-checkbox input { width: 18px; height: 18px; accent-color: var(--accent); }
.ma-close { border: 0; color: white; background: transparent; font-size: 27px; }
.ma-player { display: block; width: 100%; max-height: 65vh; margin-top: 15px; border-radius: 12px; background: #000; }
.ma-audio-player { display: grid; justify-items: center; gap: 25px; padding: 30px 15px; border-radius: 12px; background: linear-gradient(135deg, #38203c, #202d50); }
.ma-audio-art { display: grid; place-items: center; width: 150px; height: 150px; border-radius: 25px; background: #ff365f; font-size: 90px; }
.ma-audio-player audio { width: min(100%, 600px); }
.ma-player-panel h2 { overflow-wrap: anywhere; }
.ma-player-actions { display: flex; gap: 10px; }
.ma-back { margin-bottom: 5px; }
.ma-footer { display: flex; justify-content: space-between; gap: 12px; margin: 40px 0 10px; padding: 20px 0; border-top: 1px solid var(--border); color: #9ca3b6; font-size: 12px; }
.ma-mobile-nav { display: none; }

@media (max-width: 1100px) {
  .ma-media-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .ma-layout { grid-template-columns: 185px minmax(0, 1fr); }
  .ma-header { gap: 16px; }
  .ma-user-name { display: none; }
}

@media (max-width: 700px) {
  .ma-header { min-height: 64px; gap: 10px; padding: 10px 13px; }
  .ma-brand { gap: 7px; font-size: 14px; }
  .ma-brand-icon { width: 34px; height: 34px; font-size: 20px; }
  .ma-search { width: auto; flex: 1; gap: 7px; padding: 0 10px; }
  .ma-search input { min-width: 0; padding: 10px 0; font-size: 12px; }
  .ma-user { gap: 6px; }
  .ma-avatar { width: 30px; height: 30px; }
  .ma-logout { display: none; }
  .ma-layout { display: block; }
  .ma-sidebar { display: none; }
  .ma-main { padding: 15px 13px 90px; }
  .ma-hero { min-height: 230px; padding: 25px 20px; border-radius: 18px; }
  .ma-hero h1 { font-size: 28px; }
  .ma-hero-art { position: absolute; right: -65px; bottom: -18px; width: 140px; opacity: .27; }
  .ma-hero-art span { font-size: 120px; }
  .ma-hero-art i, .ma-hero-art b { display: none; }
  .ma-hero > div:first-child { max-width: 100%; }
  .ma-section-heading h2 { font-size: 22px; }
  .ma-media-grid { grid-template-columns: minmax(0, 1fr); gap: 18px; }
  .ma-media-card { border-radius: 14px; }
  .ma-card-text h3 { font-size: 15px; }
  .ma-upload-panel, .ma-player-panel { padding: 16px; }
  .ma-mobile-nav {
    position: fixed;
    z-index: 30;
    right: 0;
    bottom: 0;
    left: 0;
    display: flex;
    justify-content: space-around;
    padding: 8px 2px calc(8px + env(safe-area-inset-bottom));
    border-top: 1px solid var(--border);
    background: #0d0f18f5;
    backdrop-filter: blur(15px);
  }
  .ma-mobile-nav button { display: grid; justify-items: center; gap: 4px; min-width: 0; padding: 4px 8px; border: 0; color: #aeb3c5; background: transparent; font-size: 10px; }
  .ma-mobile-nav button span { font-size: 21px; }
  .ma-footer { font-size: 10px; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { scroll-behavior: auto !important; transition: none !important; }
}
