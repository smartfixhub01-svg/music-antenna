{
  "headers": [
    {
      "source": "/(reset|recovery)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!reset\\.html|recovery\\.html).*)",
      "destination": "/index.html"
    }
  ]
}
